<div class="block-forms">
    <div class="container">
        <div class="block-forms__content">
            <img loading="lazy" src="img/image1.webp" alt="" class="block-forms__pic1">
            <img loading="lazy" src="img/image2.webp" alt="" class="block-forms__pic2">
            <img loading="lazy" src="img/icons/line3.svg" alt="" class="block-forms__line1">
            <img loading="lazy" src="img/icons/line4.svg" alt="" class="block-forms__line2">
            <div class="block-forms__body">
                <div class="heading-complex">
                    <h2 class="title2">
                        Оставьте заявку
                    </h2>
                    <p>
                        И мы подберём тур, подходящий именно вам
                    </p>
                </div>
                <form data-dev data-popup-message="#thanks" action="#" class="form">
                    <div class="form__inputs">
                        <div class="form__input">
                            <input data-required autocomplete="off" type="text" name="form[]"
                                placeholder="Имя (Учитель/Родитель) *" class="input">
                        </div>
                        <div class="form__input">
                            <input data-required autocomplete="off" type="text" name="form[]"
                                placeholder="Номер телефона *" class="input">
                        </div>
                        <div class="form__input">
                            <input autocomplete="off" type="text" name="form[]" placeholder="Количество детей"
                                class="input">
                        </div>
                        <div class="form__input">
                            <input autocomplete="off" type="text" name="form[]" placeholder="Номер школы/класс"
                                class="input">
                        </div>
                    </div>
                    <div class="form__buttons">
                        <label class="checkbox">
                            <input checked data-required class="checkbox__input" type="checkbox" value="1"
                                name="form[]">
                            <span class="checkbox__label">
                                <span class="checkbox__icon">
                                    <svg aria-hidden="true" width="12" height="12">
                                        <use xlink:href="img/sprite.svg#check1"></use>
                                    </svg>
                                </span>
                                <span class="checkbox__text">
                                    <span>Согласие на обработку<br> <a href="./">персональных данных</a></span>
                                </span>
                            </span>
                        </label>
                        <button type="submit" class="btn">
                            <span>Рассчитать стоимость поездки для класса</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>