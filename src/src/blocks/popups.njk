<div id="call" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="10" height="10">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">
                        Заказать звонок
                    </div>
                    <p>
                        Оставьте номер телефона и наш менеджер вам перезвонит
                    </p>
                </div>
                <form data-dev data-popup-message="#thanks" action="#" class="form">
                    <div class="form__inputs">
                        <div class="form__input">
                            <input autocomplete="off" type="text" name="form[]" placeholder="Ваше имя" class="input">
                        </div>
                        <div class="form__input">
                            <input data-required autocomplete="off" type="text" name="form[]"
                                placeholder="Номер телефона *" class="input">
                        </div>
                    </div>
                    <div class="form__buttons">
                        <label class="checkbox">
                            <input checked data-required class="checkbox__input" type="checkbox" value="1"
                                name="form[]">
                            <span class="checkbox__label">
                                <span class="checkbox__icon">
                                    <svg aria-hidden="true" width="12" height="12">
                                        <use xlink:href="img/sprite.svg#check1"></use>
                                    </svg>
                                </span>
                                <span class="checkbox__text">
                                    <span>Согласие на обработку <a href="./">персональных данных</a></span>
                                </span>
                            </span>
                        </label>
                        <button type="submit" class="btn">
                            <span>Отправить</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div id="thanks" aria-hidden="true" class="popup popup-forms">
    <div class="popup__wrapper">
        <div class="popup__content">
            <div data-close class="popup__close">
                <svg aria-hidden="true" width="16" height="16">
                    <use xlink:href="img/sprite.svg#close"></use>
                </svg>
            </div>
            <div class="popup-forms__body">
                <div class="popup-forms__top">
                    <div class="popup-forms__title">Спасибо за заявку!</div>
                    <p>
                        Свяжимся с вами в ближайшее время.
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>